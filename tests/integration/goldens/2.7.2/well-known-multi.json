    {
      "name": "mpp",
      "kind": "payment",
      "implementationVersion": "<package-version>",
      "supportedSpec": "mpp/draft-httpauth-payment-01 intent=charge method=evm",
      "capabilities": [
        "intent=charge",
        "method=evm",
        "credential=authorization",
        "eip-3009",
        "network=eip155:31337",
        "network=eip155:84532",
        "network=eip155:8453",
        "asset=USDC",
        "verify-before-settle",
        "authorization-flow",
        "upfront-flow",
        "payment-receipt",
        "challenge-digest-binding"
      ],
      "status": "experimental",
      "unsupported": [
        "methods other than evm",
        "credential=permit2",
        "credential=transaction",
        "credential=hash",
        "splits",
        "intent=subscription",
        "evm sessions",
        "discovery extension"
      ]
    }
  ],
  "authorizationProviders": [
    {
      "name": "ap2",
      "kind": "authorization",
      "implementationVersion": "<package-version>",
      "supportedSpec": "ap2/v0.2.0 mode=direct",
      "capabilities": [
        "direct-mode",
        "trusted-agent-provider",
        "mandate.checkout.1",
        "sd-jwt-presentation",
        "ES256",
        "sha-256",
        "static-inline-trust",
        "merchant-checkout-jwt-binding",
        "agent-commerce/ap2/checkout/v1",
        "purchase-binding",
        "replay-defence"
