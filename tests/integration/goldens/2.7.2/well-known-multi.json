{
  "gateway": {
    "implementationVersion": "<package-version>",
    "supportedSpec": "agent-commerce/v1.0.0"
  },
  "merchant": {
    "id": "golden-store",
    "name": "Golden Store",
    "publicBaseUrl": "https://gateway.example"
  },
  "protocols": {
    "http": {
      "enabled": true
    },
    "mcp": {
      "enabled": true,
      "mountPath": "/mcp"
    },
    "a2a": {
      "enabled": true,
      "mountPath": "/a2a"
    },
    "acp": {
      "enabled": true,
      "mountPath": "/acp"
    }
  },
  "adapters": [
    {
      "name": "mcp",
      "kind": "protocol",
      "implementationVersion": "<package-version>",
      "supportedSpec": "2026-07-28, 2025-11-25",
      "capabilities": [
        "tools/list",
        "tools/call"
      ],
      "status": "stable",
      "unsupported": [
        "resources",
        "prompts",
        "sampling",
        "completions",
        "elicitation",
        "roots",
        "logging",
        "notifications/tools/list_changed",
        "tasks",
        "dns-rebinding-protection",
        "authorization",
        "sessions",
        "subscriptions",
        "pagination",
        "HTTP+SSE transport",
        "MPP payment-required as JSON-RPC error -32042",
        "MPP verification failure as JSON-RPC error -32043"
      ],
      "health": {
        "status": "pass",
        "checkedAt": "<timestamp>"
      }
    },
    {
      "name": "a2a",
      "kind": "protocol",
      "implementationVersion": "<package-version>",
      "supportedSpec": "1.0.1",
      "capabilities": [
        "agent-card",
        "jsonrpc",
        "SendMessage",
        "GetTask",
        "ListTasks",
        "CancelTask",
        "returnImmediately",
        "x402-extension"
      ],
      "status": "stable",
      "unsupported": [
        "SendStreamingMessage",
        "SubscribeToTask",
        "CreateTaskPushNotificationConfig",
        "GetTaskPushNotificationConfig",
        "ListTaskPushNotificationConfigs",
        "DeleteTaskPushNotificationConfig",
        "GetExtendedAgentCard",
        "HTTP+JSON/REST binding",
        "gRPC binding",
        "SSE",
        "resuming a background task after a restart",
        "task resumption other than an x402 extension payment",
        "push notifications",
        "multi-turn conversational continuation",
        "client-chosen contextId",
        "listing tasks across contexts",
        "task history",
        "non-empty tenant",
        "text parts",
        "file and URL parts (including inline bytes)",
        "multi-part messages",
        "message roles other than ROLE_USER",
        "authenticated extended agent cards",
        "A2A authentication schemes",
        "artifact types beyond Agent Commerce outcome data",
        "tasks across gateway instances"
      ],
      "health": {
        "status": "pass",
        "checkedAt": "<timestamp>"
      }
    },
    {
      "name": "acp",
      "kind": "protocol",
      "implementationVersion": "<package-version>",
      "supportedSpec": "2026-04-17",
      "capabilities": [
        "rest transport",
        "well-known discovery",
        "bearer authentication",
        "API-Version enforcement",
        "request header forwarding to the merchant",
        "checkout service",
        "createCheckoutSession",
        "updateCheckoutSession",
        "getCheckoutSession",
        "completeCheckoutSession",
        "cancelCheckoutSession"
      ],
      "status": "experimental",
      "unsupported": [
        "carts service",
        "feed service",
        "standalone orders service",
        "delegate_payment",
        "delegate_authentication",
        "ACP MCP transport binding",
        "webhooks",
        "outbound merchant-to-agent delivery",
        "ACP client role",
        "Signature header verification",
        "Timestamp replay-window verification",
        "discount extension",
        "general ACP extension framework",
        "multiple ACP API versions",
        "seller-backed payment handler integration"
      ],
      "health": {
        "status": "pass",
        "checkedAt": "<timestamp>"
      }
    }
  ],
  "paymentProviders": [
    {
      "name": "x402",
      "kind": "payment",
      "implementationVersion": "<package-version>",
      "supportedSpec": "x402/v2 scheme=exact family=eip155",
      "capabilities": [
        "exact-evm",
        "remote-facilitator",
        "eip-3009",
        "permit2",
        "caip-2",
        "mode=testnet",
        "authorization-flow",
        "upfront-flow",
        "multiple-offers"
      ],
      "status": "stable",
      "unsupported": [
        "permit2 gas sponsoring extensions",
        "upto scheme",
        "batch-settlement scheme",
        "auth-capture scheme",
        "x402 v1",
        "payer-bound quotes",
        "contract quote issuers (ERC-1271, ERC-6492, EIP-7702 delegates)",
        "quote consumption, single-use enforcement or revocation",
        "quote client nonces",
        "quotes for MPP, Solana or NEAR",
        "signed receipts and the x402 offer-receipt extension",
        "remote quote signers and KMS",
        "per-resource quote toggles"
