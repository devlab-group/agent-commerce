# --------------------------------------------------------------------------
# Agent Commerce Gateway — example environment
# Copy to.env for local overrides. Never commit a real.env.
# --------------------------------------------------------------------------

# Gateway
GATEWAY_PORT=8080

# Protects the operator routes (/api/receipts, /api/events, /api/events/stream),
# which expose the merchant's commerce ledger. Unset => those routes 404.
# Replace this with a real secret anywhere reachable by anyone else.
ADMIN_TOKEN=local-demo-admin-token

# Browser origin allowed to read the gateway. Empty => no browser access.
DASHBOARD_ORIGIN=http://localhost:5173
GATEWAY_PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# Merchant backend (demo)
MERCHANT_API_PORT=3000
MERCHANT_API_BASE_URL=http://localhost:3000

# Receipt store
RECEIPT_STORE_PATH=./data/receipts.sqlite

# x402 / local deterministic chain
X402_NETWORK=base-sepolia
X402_RPC_URL=http://localhost:8545
# Address of the locally deployed MockUSDC. Written by `npm run chain:deploy` to
#.deploy/local.json — copy it here. The zero address below is a placeholder and
# is REJECTED by config validation on purpose, so an unedited copy fails loudly
# rather than starting a gateway that pays nobody.
X402_ASSET=0x0000000000000000000000000000000000000000
X402_ASSET_NAME=MockUSDC
X402_ASSET_VERSION=2
X402_ASSET_DECIMALS=6

# Merchant settlement destination (NOT a gateway wallet — merchant controlled)
MERCHANT_WALLET=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# Facilitator signer used ONLY to broadcast settlement transactions on the
# local dev chain. LOCAL DEVELOPMENT ONLY — DO NOT FUND.
X402_FACILITATOR_PRIVATE_KEY=

