# --------------------------------------------------------------------------
# Agent Commerce Gateway - example environment
# Copy to .env for local overrides. Never commit a real .env.
# --------------------------------------------------------------------------

# Gateway
GATEWAY_PORT=8080

# Protects the operator routes (/api/receipts, /api/events), which expose the
# merchant's commerce ledger. Unset => those routes 404.
# Replace this with a real secret anywhere reachable by anyone else.
ADMIN_TOKEN=local-demo-admin-token

# Browser origin allowed to read the gateway. Empty => no browser access
DASHBOARD_ORIGIN=http://localhost:5173
GATEWAY_PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# Merchant backend (demo)
MERCHANT_API_PORT=3000
MERCHANT_API_BASE_URL=http://localhost:3000

# Receipt store
RECEIPT_STORE_PATH=./data/receipts.sqlite

# x402 / local deterministic chain
X402_NETWORK=eip155:84532
X402_RPC_URL=http://localhost:8545

# The six variables below come from .deploy/local.json, which
# `npm run chain:deploy` writes. The compose gateway's entrypoint exports them,
# and host-side `validate` and `doctor` fill any that are unset. Set one only to
# override the manifest on the host: any value, even an empty one, replaces it.
# A gateway started with `npm run dev:gateway` needs X402_ASSET and
# X402_FACILITATOR_PRIVATE_KEY exported.
# X402_ASSET=
# X402_ASSET_NAME=MockUSDC
# X402_ASSET_VERSION=2
# X402_ASSET_DECIMALS=6
#
# Merchant settlement destination (merchant-controlled, NOT a gateway wallet)
# MERCHANT_WALLET=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
#
# Facilitator signer that broadcasts settlement transactions on the local dev
# chain. LOCAL DEVELOPMENT ONLY - DO NOT FUND.
# X402_FACILITATOR_PRIVATE_KEY=

# Remote facilitator (facilitator.mode: remote), unset for the local demo. With
# a remote facilitator the gateway holds no signing key, and
# X402_FACILITATOR_PRIVATE_KEY above is not used.
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_FACILITATOR_TOKEN=

# MPP challenge key (payments.mpp.challengeSecret), minimum length 32. Generate
# one with `openssl rand -hex 32`; never commit a real key.
# MPP_CHALLENGE_SECRET=
